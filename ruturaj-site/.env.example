# Copy these into Netlify -> Site configuration -> Environment variables.
# Never commit real values.

# Shared passphrase that gates the progress store, the on-demand mail
# endpoint and the mail-status endpoint. Any reasonably long random string;
# the same value is entered once per device in Settings.
BLUEPRINT_KEY=

# Gmail SMTP for the two daily mails. SENDER_PASS is a Gmail app password
# (Google account -> Security -> 2-Step Verification -> App passwords),
# never the account password. MY_EMAIL is where the mails go.
SENDER_EMAIL=
SENDER_PASS=
MY_EMAIL=

# Optional. The site URL the mail buttons link to. Defaults to
# https://winner-ruturaj.netlify.app; set it only if the site is renamed.
# SITE_URL=
